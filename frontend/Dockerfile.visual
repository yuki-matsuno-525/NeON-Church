# syntax=docker/dockerfile:1

# Visual baselines must not inherit mutable runner runtimes or fonts. Copy the
# reviewed Python and Node installations into the exact Playwright browser image.
FROM python:3.13.15-slim@sha256:9d2e5553305c7c7b0097999bb17187c69b921ccd6bc9d40e4bb5ebe652c00285 AS python-runtime
FROM node:22.23.1-bookworm-slim@sha256:8607a9064d4a571140998ae9e52a3b3fcf9cff361d04642d5971e6cd76d39e27 AS node-runtime

FROM mcr.microsoft.com/playwright:v1.59.1-noble@sha256:eac9b0a5312cdab40ee8c2429df5bf19bffdccf8f3bf3c42268e173f97541645

COPY --from=python-runtime /usr/local/ /usr/local/
COPY --from=node-runtime /usr/local/ /usr/local/

RUN test "$(python --version)" = "Python 3.13.15" \
    && test "$(node --version)" = "v22.23.1" \
    && test "$(npm --version)" = "10.9.8"

WORKDIR /work

