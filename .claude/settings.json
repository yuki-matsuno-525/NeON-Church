{
  "permissions": {
    "deny": [
      "Bash(npm run dev*)",
      "Bash(next dev*)",
      "Bash(npx next dev*)",
      "Bash(yarn dev*)",
      "Bash(pnpm dev*)",
      "Bash(docker compose down*)",
      "Bash(docker-compose down*)",
      "Read(./.env)"
    ],
    "allow": [
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose exec *)",
      "Bash(docker compose up -d*)",
      "Bash(docker compose start*)",
      "Bash(docker compose stop*)",
      "Bash(docker compose restart*)",
      "Bash(docker compose build*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push*)",
      "Bash(gh run *)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(npm test*)",
      "Bash(npm run lint*)",
      "Bash(npm run build*)",
      "Bash(npx vitest *)",
      "Bash(npx playwright *)",
      "Bash(npx tsc *)",
      "Bash(pytest*)",
      "Bash(python manage.py check*)",
      "Bash(python manage.py makemigrations --check*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -s -o /dev/null *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/ci-watch.sh\"",
            "if": "Bash(*git push*)",
            "shell": "bash",
            "timeout": 600,
            "statusMessage": "GitHub Actions を監視中...",
            "asyncRewake": true
          }
        ]
      }
    ]
  }
}
